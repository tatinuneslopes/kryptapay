{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/app(?:\\.html)?(?:\\?.*)?$",
      "dest": "/public/app.html"
    },
    {
      "src": "^/index(?:\\.html)?(?:\\?.*)?$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/(?:\\?.*)?$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/$1"
    }
  ]
}
