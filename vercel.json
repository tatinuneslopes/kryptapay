{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/(css|js|icons|assets|audio)/(.*)$",
      "dest": "/public/$1/$2"
    },
    {
      "src": "^/(sw\\.js|manifest\\.json|version\\.json|favicon\\.ico)$",
      "dest": "/public/$1"
    },
    {
      "src": "^/(index\\.html)?$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/app(?:\\.html)?$",
      "dest": "/public/app.html"
    },
    {
      "src": "/.*object.*",
      "dest": "/public/app.html?tab=test-dashboard"
    },
    {
      "src": "^/(?:test-)?dashboard(?:.*)?$",
      "dest": "/public/app.html?tab=test-dashboard"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/app.html"
    }
  ]
}
